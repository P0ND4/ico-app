# Environment target: development | staging | production
APP_ENV=development

# Google Sign-In — Web client ID (tipo "Aplicación web", NO Android)
# Debe coincidir con GOOGLE_CLIENT_ID en ico-backend/.env
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Android: creá también un cliente OAuth "Android" en Google Cloud con:
# - Package name: com.lmacml.ico
# - SHA-1: pnpm android:sha1 (usa android/app/debug.keystore de Expo)

# AdMob App IDs (native build — from Google AdMob console)
ADMOB_APP_ID_IOS=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
ADMOB_APP_ID_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx

# AdMob Ad Unit IDs (runtime — from Google AdMob console)
EXPO_PUBLIC_AD_UNIT_INTERSTITIAL_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
EXPO_PUBLIC_AD_UNIT_INTERSTITIAL_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx